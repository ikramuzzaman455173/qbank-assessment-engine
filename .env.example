# ==============================================================================
# QBank — Environment Configuration Template
# Copy this file to .env or .env.local and fill in your actual credentials.
# NEVER commit your actual .env file with real secrets to version control.
# ==============================================================================

# Supabase Database & Auth Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key-here"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# Server-Side / Node Compatibility Aliases
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key-here"
SUPABASE_PROJECT_ID="your-project-ref"

# Google Gemini AI API Key
# Required for AI-powered MCQ generation, PDF question extraction, and validation
# Obtain a free key from Google AI Studio: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY="your-google-gemini-api-key-here"
